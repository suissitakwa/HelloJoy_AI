# Copy to .env.local. VITE_ values are public: they ship in the browser bundle.
# Never put a secret here.

# The demo receptionist's backend (the PawCare voice receptionist API), no trailing slash.
# Its CORS_ALLOWED_ORIGINS must include this site's origin.
VITE_DEMO_API_URL=http://localhost:8000

# All optional.
# Your business line in E.164, for example +13105550123. Shows click-to-call.
VITE_AGENCY_PHONE=
# A Calendly or Cal.com link for "Book a meeting".
VITE_BOOKING_URL=
# Where owners sign up, for example https://your-pawcare-site.netlify.app/get-started
VITE_SIGNUP_URL=
VITE_SERVICE_AREA=Los Angeles
